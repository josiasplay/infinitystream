# Copie para bridge/.env (ou use keys/*.txt). Variáveis de ambiente têm prioridade.

# Segredo compartilhado com o frontend (VITE_BRIDGE_TOKEN). Gere: openssl rand -hex 32
BRIDGE_TOKEN=

# Domínio público da bridge (o Nginx termina o TLS)
BRIDGE_DOMAIN=bridge.seudominio.com
# Alternativa: URL completa
# PUBLIC_URL=https://bridge.seudominio.com

# Origens extras do CORS (*.pages.dev já é aceito)
ALLOWED_ORIGINS=https://stream.seudominio.com

# Hosts dos quais a bridge pode baixar .torrent (anti-SSRF)
ALLOWED_TORRENT_HOSTS=archive.org,webtorrent.io

PORT=3000
HOST=127.0.0.1
CACHE_DIR=/home/ubuntu/torrents-cache
MAX_CACHE_GB=30
MAX_ACTIVE_TORRENTS=4
IDLE_TTL_MIN=30
GC_INTERVAL_MIN=5
METADATA_TIMEOUT_S=45
MAX_CONNS=40
DOWNLOAD_LIMIT_KBPS=-1
UPLOAD_LIMIT_KBPS=-1
RATE_LIMIT_PER_MIN=120
