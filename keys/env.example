# =====================================================================
# Arquivos esperados em keys/ (um valor por arquivo, sem aspas)
# Tudo em keys/ é ignorado pelo git, exceto este arquivo e .gitkeep.
# Os scripts leem PRIMEIRO variáveis de ambiente e, se não existirem,
# o arquivo correspondente abaixo.
# =====================================================================

# keys/tmdb_api_key.txt      -> TMDB_API_KEY
#   Chave v3 da API do TMDB: https://www.themoviedb.org/settings/api
TMDB_API_KEY=coloque_sua_chave_v3_aqui

# keys/bridge_token.txt      -> BRIDGE_TOKEN
#   Token secreto compartilhado entre frontend e bridge.
#   Gere com: openssl rand -hex 32
BRIDGE_TOKEN=gere_um_token_aleatorio

# keys/oracle_host.txt       -> ORACLE_HOST
#   IP público (ou hostname) da VM Oracle
ORACLE_HOST=123.45.67.89

# keys/bridge_domain.txt     -> BRIDGE_DOMAIN
#   Domínio apontando para a VM (necessário para HTTPS/Let's Encrypt)
BRIDGE_DOMAIN=bridge.seudominio.com

# keys/certbot_email.txt     -> CERTBOT_EMAIL
#   E-mail usado no Let's Encrypt (avisos de expiração)
CERTBOT_EMAIL=voce@exemplo.com

# keys/allowed_origins.txt   -> ALLOWED_ORIGINS
#   Origens extras aceitas pelo CORS da bridge (separadas por vírgula).
#   *.pages.dev já é aceito por padrão.
ALLOWED_ORIGINS=https://stream.seudominio.com

# keys/oracle_ssh_key        -> chave PRIVADA SSH da VM (baixada ao criar a VM)
# keys/oracle_ssh_key.pub    -> chave PÚBLICA correspondente
