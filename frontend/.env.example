# Copie para frontend/.env.local (dev) ou configure no Cloudflare Pages.
# ATENÇÃO: toda variável VITE_* vai embutida no JavaScript público do site.

# Chave v3 do TMDB (https://www.themoviedb.org/settings/api)
VITE_TMDB_API_KEY=

# URL HTTPS da bridge na Oracle (sem barra no final)
VITE_ORACLE_BRIDGE_URL=https://bridge.seudominio.com

# Token da bridge. RECOMENDADO deixar vazio e informar pela tela de
# Configurações (fica só no localStorage do seu navegador), para não
# publicar o token no bundle. Se preencher, proteja o site com Cloudflare Access.
VITE_BRIDGE_TOKEN=
